{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foji",
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Dominio: usa un SUBDOMINIO para no pisar el sitio principal forge-sh.dev.
  "routes": [
    { "pattern": "foji.forge-sh.dev", "custom_domain": true }
  ],
  // Al definir "routes", wrangler desactiva *.workers.dev por defecto.
  // La mantenemos activa para no romper integraciones (ej. GitHub OAuth
  // callback) que puedan seguir apuntando a la URL vieja.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },

  // --- D1 (SQLite) ---
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foji-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // --- Durable Objects (chat rooms, one per project) ---
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],

  // --- R2 (declared for a future file-upload phase; unused for now) ---
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "foji-files"
    }
  ],

  // --- Rate limiting (public /p/[token] brute-force protection) ---
  "unsafe": {
    "bindings": [
      {
        "name": "PUBLIC_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  },

  "vars": {
    // Non-secret defaults. Secrets (SESSION_SECRET, GITHUB_APP_*, TELEGRAM_*)
    // are set via `wrangler secret put` or a .dev.vars file for local dev.
    "APP_NAME": "Fōji — FORGE/SH"
  }
}
